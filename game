def add_active_pet(pn):
    inf = get_pet(pn)
    o = c.create_oval(px, py, px + 14, py + 14, fill=inf["col"], outline="white", width=1)
    t = c.create_text(px, py - 10, text=pn, fill=inf["col"], font=("Segoe UI", 8, "bold"))
    active_pets.append({"x": float(px), "y": float(py), "rate": inf["rate"], "o": o, "t": t})

def start_game():
    global state, px, py, vx, vy, ps, base_spd, sc, exp_sc, dash_cd, dash_t, shield_t, slow_t, combo, combo_t, wave_r, buff, wild_pet, pet_t, skin_idx
    if get_skin()["name"] not in owned_skins: skin_idx = 0
    state = "GAME"; px, py, vx, vy, ps, base_spd, sc, exp_sc = float(W // 2), float(H // 2), 0.0, 0.0, 34, 6.5, 0, 0
    dash_cd, dash_t, shield_t, slow_t, combo, combo_t, wave_r, buff, wild_pet, pet_t = 0, 0, 0, 0, 1, 0, 0, None, None, 0
    reset_canvas(); s = get_skin(); mp = get_map(); keys.clear()
    c.create_rectangle(14, 14, W - 14, 68, fill=mp["panel"], outline=mp["border"], width=2)
    objs["wave"] = c.create_oval(0, 0, 0, 0, outline=mp["border"], width=3, state="hidden")
    objs["sh"] = c.create_oval(0, 0, 0, 0, outline="#00F0FF", width=2, state="hidden")
    objs["pb"] = c.create_rectangle(0, 0, 0, 0, fill=s["c2"], outline=s["c1"], width=3)
    objs["el"] = c.create_oval(0, 0, 0, 0, fill=s["eye"], outline="")
    objs["er"] = c.create_oval(0, 0, 0, 0, fill=s["eye"], outline="")
    objs["co"] = c.create_oval(0, 0, 0, 0, fill="#FF9100", outline="#FFD600", width=2)
    objs["ci"] = c.create_oval(0, 0, 0, 0, fill="#FFD600", outline="")
    objs["t1"] = c.create_text(32, 41, anchor="w", fill="#00F0FF", font=("Segoe UI", 14, "bold"))
    objs["t2"] = c.create_text(180, 41, anchor="w", fill="#FFD600", font=("Segoe UI", 14, "bold"))
    objs["t3"] = c.create_text(365, 41, anchor="w", fill="#00FF88", font=("Segoe UI", 13, "bold"))
    objs["t4"] = c.create_text(W - 32, 41, anchor="e", fill="#FF1744", font=("Segoe UI", 14, "bold"))
    c.create_text(W // 2, H - 26, text="WASD: Drift  •  [SPACE]: Dash  •  [P]: Pets Base  •  [ESC]: Menu", fill="#64748B", font=("Segoe UI", 10, "bold"))
    for pn in saved_pets: add_active_pet(pn)
    for _ in range(3 if MODES[mode_idx] == "CHAOS" else 1): spawn_enemy()

def on_key(e):
    global dash_cd, dash_t
    keys.add(e.keycode)
    if state == "GAME" and not get_ban():
        if e.keycode == 27: save_data(); open_menu()
        if e.keycode == 80: save_data(); open_pets()
        if e.keycode == 32 and dash_cd <= 0:
            dash_cd, dash_t = 80, 6; sfx(650, 30)
            add_sparks(px + ps / 2, py + ps / 2, get_skin()["c1"], 8)

root.bind("<KeyPress>", on_key)
root.bind("<KeyRelease>", lambda e: keys.discard(e.keycode))
def loop():
    global state, px, py, vx, vy, ps, base_spd, sc, exp_sc, hs, money, exp_money, cx, cy, pulse
    global dash_cd, dash_t, ldx, ldy, shield_t, slow_t, combo, combo_t, wave_r, buff, wild_pet, pet_t
    banned, rem, reason = get_ban()
    if banned:
        if state != "BANNED":
            state = "BANNED"; reset_canvas(); c.configure(bg="#14050A")
            c.create_rectangle(100, 120, W - 100, H - 120, fill="#1F0810", outline="#FF1744", width=3)
            c.create_text(W // 2, 200, text="ACCOUNT SUSPENDED", fill="#FF1744", font=("Segoe UI", 32, "bold"))
            c.create_text(W // 2, 260, text=f"Auto-AC: {reason}", fill="#FFD600", font=("Segoe UI", 14, "bold"))
            objs["bt"] = c.create_text(W // 2, 330, fill="#00F0FF", font=("Segoe UI", 24, "bold"))
        c.itemconfig(objs["bt"], text=f"Unban in {rem}s")
        keys.clear(); return root.after(200, loop)
    elif state == "BANNED": open_menu()
    if state == "GAME":
        # Авто-проверка целостности данных (античит без кнопок)
        if base_spd != 6.5 or ps < 14 or ps > 36: set_ban("Player Attributes Altered"); return root.after(16, loop)
        if sc != exp_sc or money != exp_money or money < 0: set_ban("Memory / Save Tampering"); return root.after(16, loop)
        if dash_cd > 0: dash_cd -= 1
        if shield_t > 0: shield_t -= 1
        if slow_t > 0: slow_t -= 1
        if combo_t > 0: combo_t -= 1
        else: combo = 1
        ix = (-1 if (65 in keys or 37 in keys) else 0) + (1 if (68 in keys or 39 in keys) else 0)
        iy = (-1 if (87 in keys or 38 in keys) else 0) + (1 if (83 in keys or 40 in keys) else 0)
        if ix or iy:
            ln = math.hypot(ix, iy); ldx, ldy = ix / ln, iy / ln
        if dash_t > 0:
            dash_t -= 1; vx, vy = ldx * 21.0, ldy * 21.0
        else:
            tx_v = (ix / math.hypot(ix, iy) * base_spd) if (ix or iy) else 0.0
            ty_v = (iy / math.hypot(ix, iy) * base_spd) if (ix or iy) else 0.0
            vx += (tx_v - vx) * 0.28; vy += (ty_v - vy) * 0.28
        px = max(18.0, min(float(W - ps - 18), px + vx))
        py = max(72.0, min(float(H - ps - 18), py + vy))
        if wave_r > 0:
            wave_r += 18
            c.itemconfig(objs["wave"], state="normal")
            c.coords(objs["wave"], px + ps/2 - wave_r, py + ps/2 - wave_r, px + ps/2 + wave_r, py + ps/2 + wave_r)
            for e in enemies:
                d = math.hypot(e["x"] - px, e["y"] - py)
                if 0 < d < wave_r + 30:
                    e["dx"] = ((e["x"] - px) / d) * 5.0; e["dy"] = ((e["y"] - py) / d) * 5.0
            if wave_r > 240: wave_r = 0; c.itemconfig(objs["wave"], state="hidden")
        for pt in list(particles):
            pt["x"] += pt["dx"]; pt["y"] += pt["dy"]; pt["life"] -= 1
            if pt["life"] <= 0: c.delete(pt["id"]); particles.remove(pt)
            else: c.coords(pt["id"], pt["x"] - 2, pt["y"] - 2, pt["x"] + 2, pt["y"] + 2)
        for pp in list(popups):
            pp["y"] -= 1.2; pp["life"] -= 1
            if pp["life"] <= 0: c.delete(pp["id"]); popups.remove(pp)
            else: c.coords(pp["id"], pp["x"], pp["y"])
        chance = 180 if pet_often else 1800
        if wild_pet is None and random.randint(1, chance) == 1:
            wx, wy = random.randint(70, W - 90), random.randint(110, H - 90)
            pd = random.choices(PETS_DB, weights=[p["w"] for p in PETS_DB]).pop()
            o1 = c.create_oval(wx, wy, wx + 24, wy + 24, fill="#111726", outline=pd["col"], width=3)
            o2 = c.create_text(wx + 12, wy - 12, text=f"{pd['name']} (+{pd['rate']}$/s)", fill=pd["col"], font=("Segoe UI", 9, "bold"))
            wild_pet = {"x": wx, "y": wy, "data": pd, "o1": o1, "o2": o2, "life": 480}
        if wild_pet:
            wild_pet["life"] -= 1
            if px < wild_pet["x"] + 24 and px + ps > wild_pet["x"] and py < wild_pet["y"] + 24 and py + ps > wild_pet["y"]:
                pd = wild_pet["data"]
                c.delete(wild_pet["o1"]); c.delete(wild_pet["o2"]); wild_pet = None
                if is_filtered(pd["name"]) or len(saved_pets) >= 12:
                    sfx(1300, 35); money += pd["sell"]; exp_money = money; save_data()
                    add_sparks(px + ps/2, py + ps/2, "#FFD600", 10)
                    add_popup(px + ps/2, py - 15, f"AUTO-SOLD {pd['name']} (+{pd['sell']}$)", "#FFD600")
                else:
                    sfx(1046, 50); add_sparks(px + ps/2, py + ps/2, pd["col"], 14)
                    add_popup(px + ps/2, py - 15, f"CAUGHT {pd['name']}!", pd["col"])
                    saved_pets.append(pd["name"]); save_data(); add_active_pet(pd["name"])
            elif wild_pet["life"] <= 0:
                c.delete(wild_pet["o1"]); c.delete(wild_pet["o2"]); wild_pet = None
        inc = sum(p["rate"] for p in active_pets)
        pet_t += 1
        if pet_t >= 60 and inc > 0:
            pet_t = 0; money += inc; exp_money += inc; save_data()
            add_popup(px + ps/2, py - 10, f"+{inc}$", "#00FF88")
        for i, p in enumerate(active_pets):
            a = pulse + i * 1.1
            tx, ty = px + ps/2 + math.cos(a) * (ps + 18) - 7, py + ps/2 + math.sin(a) * (ps + 18) - 7
            p["x"] += (tx - p["x"]) * 0.16; p["y"] += (ty - p["y"]) * 0.16
            c.coords(p["o"], p["x"], p["y"], p["x"] + 14, p["y"] + 14); c.coords(p["t"], p["x"] + 7, p["y"] - 9)
        if buff is None and random.randint(1, 340) == 1:
            bx, by = random.randint(60, W - 80), random.randint(100, H - 80)
            bt = random.choice(["SHIELD", "SLOW"])
            bc = "#00F0FF" if bt == "SHIELD" else "#D500F9"
            o1 = c.create_rectangle(bx, by, bx + 22, by + 22, fill="#111726", outline=bc, width=2)
            o2 = c.create_text(bx + 11, by + 11, text="S" if bt == "SHIELD" else "T", fill=bc, font=("Segoe UI", 10, "bold"))
            buff = {"x": bx, "y": by, "type": bt, "o1": o1, "o2": o2}
        if buff and px < buff["x"] + 22 and px + ps > buff["x"] and py < buff["y"] + 22 and py + ps > buff["y"]:
            sfx(950, 40); add_popup(px + ps/2, py - 15, f"{buff['type']}!", "#00F0FF")
            if buff["type"] == "SHIELD": shield_t = 300
            else: slow_t = 300
            c.delete(buff["o1"]); c.delete(buff["o2"]); buff = None
        sm = 0.45 if slow_t > 0 else 1.0
        hit = False
        for e in enemies:
            if e["type"] == "SEEKER":
                ang = math.atan2(py - e["y"], px - e["x"])
                e["dx"] += math.cos(ang) * 0.08; e["dy"] += math.sin(ang) * 0.08
                sp_cur = math.hypot(e["dx"], e["dy"])
                if sp_cur > 3.2: e["dx"] = (e["dx"]/sp_cur)*3.2; e["dy"] = (e["dy"]/sp_cur)*3.2
            e["x"] += e["dx"] * sm; e["y"] += e["dy"] * sm
            sz = e["sz"]
            if e["x"] <= 18 or e["x"] >= W - sz - 18: e["dx"] *= -1
            if e["y"] <= 72 or e["y"] >= H - sz - 18: e["dy"] *= -1
            if e["type"] == "SEEKER":
                c.coords(e["o1"], e["x"]+sz/2, e["y"], e["x"]+sz, e["y"]+sz/2, e["x"]+sz/2, e["y"]+sz, e["x"], e["y"]+sz/2)
            else:
                c.coords(e["o1"], e["x"], e["y"], e["x"] + sz, e["y"] + sz)
            if px < e["x"] + sz and px + ps > e["x"] and py < e["y"] + sz and py + ps > e["y"]: hit = True
        if px < cx + cs and px + ps > cx and py < cy + cs and py + ps > cy:
            sfx(1100, 30); add_sparks(cx + cs/2, cy + cs/2, "#FFD600", 8)
            gain = 2 * combo; sc += 1; exp_sc += 1; money += gain; exp_money += gain
            add_popup(cx, cy - 10, f"+{gain}$ (x{combo})", "#FFD600")
            combo = min(5, combo + 1); combo_t = 150
            if sc > hs: hs = sc
            save_data()
            cx, cy = random.randint(50, W - 70), random.randint(90, H - 70)
            step = 4 if MODES[mode_idx] == "CHAOS" else 5
            if sc % step == 0:
                sfx(880, 50); wave_r = 25; add_popup(px + ps/2, py - 25, "SHOCKWAVE!", "#00F0FF")
                if ps > 15: ps = max(15, ps - 3)
                for _ in range(min(len(enemies), 8)): spawn_enemy()
        if hit and shield_t <= 0 and dash_t <= 0:
            sfx(160, 140); add_sparks(px + ps/2, py + ps/2, "#FF1744", 16); return open_gameover()
        c.itemconfig(objs["sh"], state="normal" if shield_t > 0 else "hidden")
        c.coords(objs["sh"], px - 8, py - 8, px + ps + 8, py + ps + 8)
        c.coords(objs["pb"], px, py, px + ps, py + ps)
        er, lx, ly = max(2, ps * 0.08), ix * (ps * 0.08), iy * (ps * 0.08)
        ey, elx, erx = py + ps * 0.42 + ly, px + ps * 0.33 + lx, px + ps * 0.67 + lx
        c.coords(objs["el"], elx - er, ey - er, elx + er, ey + er); c.coords(objs["er"], erx - er, ey - er, erx + er, ey + er)
        pulse += 0.14; p = math.sin(pulse) * 2
        c.coords(objs["co"], cx - p, cy - p, cx + cs + p, cy + cs + p)
        c.coords(objs["ci"], cx + 4 - p/2, cy + 4 - p/2, cx + cs - 4 + p/2, cy + cs - 4 + p/2)
        c.itemconfig(objs["t1"], text=f"SCORE: {sc}"); c.itemconfig(objs["t2"], text=f"MONEY: {money}$")
        c.itemconfig(objs["t3"], text=f"COMBO x{combo}  •  +{inc}$/s"); c.itemconfig(objs["t4"], text=f"THREATS: {len(enemies)}")
    root.after(16, loop)

open_menu()
loop()
root.mainloop()

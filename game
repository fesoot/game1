def sfx(freq, dur=25):
    if sfx_on and winsound:
        try: winsound.Beep(freq, dur)
        except Exception: pass
def load_data():
    hs, mon, own, pts = 0, 0, {"AETHER"}, []
    try:
        if os.path.exists("aether.sav"):
            d = open("aether.sav", encoding="utf-8").read().split("|")
            hs, mon = int(d.pop(0)), int(d.pop(0))
            if d:
                s_raw = d.pop(0)
                if s_raw: own = set(s_raw.split(","))
            if d:
                p_raw = d.pop(0)
                if p_raw: pts = p_raw.split(",")
    except Exception: pass
    return hs, mon, own, pts

def save_data():
    try:
        raw = f"{hs}|{money}|{','.join(owned_skins)}|{','.join(saved_pets)}"
        open("aether.sav", "w", encoding="utf-8").write(raw)
    except Exception: pass

hs, money, owned_skins, saved_pets = load_data()
exp_money, sc, exp_sc = money, 0, 0
px, py, vx, vy, ps, base_spd = W // 2, H // 2, 0.0, 0.0, 34, 6.5
cx, cy, cs, pulse = random.randint(60, W - 80), random.randint(100, H - 80), 20, 0.0
dash_cd, dash_t, ldx, ldy = 0, 0, 1.0, 0.0
shield_t, slow_t, pet_t, combo, combo_t, wave_r = 0, 0, 0, 1, 0, 0
buff, wild_pet = None, None
active_pets, enemies, particles, popups, keys, objs = [], [], [], [], set(), {}

def get_map(): return MAPS[map_idx % len(MAPS)]
def get_skin(): return SKINS[skin_idx % len(SKINS)]
def get_pet(name):
    for p in PETS_DB:
        if p["name"] == name: return p
    return PETS_DB

def reset_canvas():
    global c
    c.destroy()
    mp = get_map()
    c = tk.Canvas(root, width=W, height=H, bg=mp["bg"], highlightthickness=0)
    c.pack()
    c.bind("<Button-1>", lambda e: root.focus_force())
    enemies.clear(); particles.clear(); popups.clear(); active_pets.clear(); objs.clear()
    for x in range(14, W - 14, 42): c.create_line(x, 72, x, H - 14, fill=mp["grid"])
    for y in range(72, H - 14, 42): c.create_line(14, y, W - 14, y, fill=mp["grid"])
    c.create_rectangle(14, 14, W - 14, H - 14, outline=mp["border"], width=2)

def is_filtered(pname):
    f = FILTERS[filter_idx]
    if f == "NOOBINI" and pname == "NOOBINI": return True
    if f == "<= SIGMA CAT" and pname in ("NOOBINI", "SIGMA CAT"): return True
    if f == "<= SKIBIDI BOT" and pname in ("NOOBINI", "SIGMA CAT", "SKIBIDI BOT"): return True
    return False

def get_ban():
    if os.path.exists("ban.dat"):
        try:
            t, r = open("ban.dat", encoding="utf-8").read().split("|", 1)
            if time.time() < float(t): return True, int(float(t) - time.time()) + 1, r
            os.remove("ban.dat")
        except Exception:
            try: os.remove("ban.dat")
            except Exception: pass
    return False, 0, ""

def set_ban(r):
    global hs, money, exp_money, saved_pets
    sfx(200, 250); hs, money, exp_money, saved_pets = 0, 0, 0, []; save_data()
    try: open("ban.dat", "w", encoding="utf-8").write(f"{time.time() + 60}|{r}")
    except Exception: pass

def add_popup(x, y, txt, col):
    if len(popups) > 10: return
    tid = c.create_text(x, y, text=txt, fill=col, font=("Segoe UI", 11, "bold"))
    popups.append({"id": tid, "x": x, "y": y, "life": 25})

def add_sparks(x, y, col, n=8):
    if len(particles) > 28: return
    for _ in range(n):
        a, v = random.uniform(0, 6.28), random.uniform(2, 6)
        pid = c.create_oval(x - 3, y - 3, x + 3, y + 3, fill=col, outline="")
        particles.append({"id": pid, "x": x, "y": y, "dx": math.cos(a) * v, "dy": math.sin(a) * v, "life": 12})

def spawn_enemy():
    if len(enemies) >= 32:
        for e in enemies: e["dx"] *= 1.04; e["dy"] *= 1.04
        return
    while True:
        ex, ey = random.randint(40, W - 70), random.randint(90, H - 70)
        if math.hypot(ex - px, ey - py) > 165: break
    etype = random.choices(["BALL", "SEEKER", "SPEED"], weights=[60, 25, 15]).pop()
    m = MODES[mode_idx]
    sp = (4.8 if m == "HARDCORE" else 3.5) * (1.55 if etype == "SPEED" else (0.75 if etype == "SEEKER" else 1.0))
    sz = 18 if etype == "SPEED" else 28
    ang = random.uniform(0, 6.28)
    if etype == "BALL":
        o1 = c.create_oval(ex, ey, ex + sz, ey + sz, fill="#2A0815", outline="#FF1744", width=2)
    elif etype == "SEEKER":
        o1 = c.create_polygon(ex + sz/2, ey, ex + sz, ey + sz/2, ex + sz/2, ey + sz, ex, ey + sz/2, fill="#331A00", outline="#FF9100", width=2)
    else:
        o1 = c.create_rectangle(ex, ey, ex + sz, ey + sz, fill="#240038", outline="#D500F9", width=2)
    enemies.append({"o1": o1, "type": etype, "sz": sz, "x": ex, "y": ey, "dx": math.cos(ang) * sp, "dy": math.sin(ang) * sp})
def glass_btn(x, y, w, h, txt, accent, cmd):
    mp = get_map()
    r = c.create_rectangle(x - w//2, y - h//2, x + w//2, y + h//2, fill=mp["panel"], outline=accent, width=2)
    t = c.create_text(x, y, text=txt, fill="#FFFFFF", font=("Segoe UI", 11, "bold"))
    def over(e): c.itemconfig(r, fill=mp["grid"])
    def out(e): c.itemconfig(r, fill=mp["panel"])
    def clk(e): sfx(700, 20); cmd()
    for item in (r, t):
        c.tag_bind(item, "<Enter>", over); c.tag_bind(item, "<Leave>", out); c.tag_bind(item, "<Button-1>", clk)


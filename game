    c.create_text(W // 2, 52, text="BRAINROT SANCTUARY", fill="#00FF88", font=("Segoe UI", 26, "bold"))
    c.create_text(W // 2, 88, text=f"SLOTS: {len(saved_pets)}/12   •   BALANCE: {money}$   •   +{inc}$/s", fill="#FFD600", font=("Segoe UI", 12, "bold"))
    if not saved_pets:
        c.create_text(W // 2, 260, text="Base is empty! Catch glowing pets in the arena.", fill="#64748B", font=("Segoe UI", 14))
    else:
        for i, pn in enumerate(saved_pets):
            inf = get_pet(pn)
            bx, by = 185 + (i % 3) * 245, 155 + (i // 3) * 92
            c.create_rectangle(bx - 108, by - 36, bx + 108, by + 36, fill=mp["panel"], outline=inf["col"], width=2)
            c.create_oval(bx - 96, by - 14, bx - 68, by + 14, fill=inf["col"], outline="white", width=2)
            c.create_text(bx + 18, by - 18, text=f"{pn} (+{inf['rate']}$/s)", fill=inf["col"], font=("Segoe UI", 10, "bold"))
            def make_sell(idx, val):
                def do_sell():
                    global money, exp_money
                    saved_pets.pop(idx); money += val; exp_money = money
                    save_data(); sfx(1200, 40); open_pets()
                return do_sell
            glass_btn(bx + 18, by + 12, 130, 26, f"SELL (+{inf['sell']}$)", "#FFD600", make_sell(i, inf["sell"]))
